# ------------------------------------------------------------------------------
# 1. HOW TO STOP A RUNNING PROGRAM
# ------------------------------------------------------------------------------
# Method A (Standard):
#   Click inside the terminal window running the app and press:
#   Ctrl + C   (or Ctrl + Break)

# Method B (PowerShell - Kill process holding Port 8000):
Stop-Process -Id (Get-NetTCPConnection -LocalPort 8000 -ErrorAction SilentlyContinue).OwningProcess -Force

# Method C (PowerShell - Kill all python processes if hung):
Get-Process python -ErrorAction SilentlyContinue | Stop-Process -Force

# Method D (CMD / Command Prompt):
#   for /f "tokens=5" %a in ('netstat -ano ^| findstr :8000') do taskkill /PID %a /F


# ------------------------------------------------------------------------------
# 2. RUNNING THE APPLICATION
# ------------------------------------------------------------------------------
# Launch Web Dashboard (Main UI at http://127.0.0.1:8000):
.\.venv\Scripts\python -m app.main

# Or explicitly:
.\.venv\Scripts\python -m app dashboard

# Alternative direct server module runner:
.\.venv\Scripts\python -m app.web.server

# Interactive Terminal Chat mode:
.\.venv\Scripts\python -m app chat

# Hands-Free / Push-To-Talk Voice mode in Terminal:
.\.venv\Scripts\python -m app voice

# Startup Banner and System Config Check:
.\.venv\Scripts\python -m app

.\.venv\Scripts\python -m app.main

# ------------------------------------------------------------------------------
# 3. RUNNING TESTS (Pytest)
# ------------------------------------------------------------------------------
# Run all tests:
.\.venv\Scripts\python -m pytest tests/

# Run tests with short summary:
.\.venv\Scripts\python -m pytest tests/ -q --tb=short

# Run specific test suite (e.g., Voice & Wakeword tests):
.\.venv\Scripts\python -m pytest tests/test_voice_advanced.py -v

# Run with stdout printing enabled (-s):
.\.venv\Scripts\python -m pytest tests/test_voice_advanced.py -s -v


