# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Verify the current free-tier model name in AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite

# Logging
LOG_LEVEL=INFO

# Web server
WEB_PORT=8000
WEB_HOST=127.0.0.1

# MQTT Settings
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Phase 3: Durable Memory
MEMORY_ENABLED=true

# Phase 4: Voice Settings
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto
TTS_ENGINE=edge-tts
TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_TA=ta-IN-PallaviNeural
WAKE_WORD_ENGINE=pushtotalk
WAKE_WORD_KEYWORD=hey jarvis
WAKE_WORD_SENSITIVITY=0.5
VAD_AGGRESSIVENESS=2
